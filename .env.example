# Copy this file to .env.local and fill in the values
# .env.local is gitignored and will NOT be committed

# Gemini API key from Google AI Studio (aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
# Defaults to gemini-3.5-flash-lite, which has a free tier for supported keys
GEMINI_MODEL=gemini-3.5-flash-lite

# Firebase Admin — for Vercel, paste the full JSON content of your service account as a single-line string
# Locally, just keep service-account.json in the project root
FIREBASE_SERVICE_ACCOUNT=
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Planner dashboard passcode
PLANNER_PASSCODE=

# Optional WhatsApp Cloud API; leave blank to keep the webhook disabled
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
